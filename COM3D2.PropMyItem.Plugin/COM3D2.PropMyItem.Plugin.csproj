<Project Sdk="Microsoft.NET.Sdk">

  <!--
    双版本构建矩阵 / Dual-version build matrix

      COM3D2-Debug / COM3D2-Release
          -> COM3D2 (Unity 5.6.4, net35)，定义 COM3D2
          -> bin\Debug|Release\COM3D2\net35\
      COM3D25_UNITY_2022-Debug / COM3D25_UNITY_2022-Release
          -> COM3D2.5 (Unity 2022.3, net48)，定义 COM3D25_UNITY_2022
          -> bin\Debug|Release\COM3D25\net48\

    用法：dotnet build -c COM3D2-Release
          dotnet build -c COM3D25_UNITY_2022-Release
  -->

  <Choose>
    <!-- COM3D2 (2.x, Unity 5.6.4) 依赖 -->
    <When Condition="$(Configuration.Contains('COM3D2-'))">
      <ItemGroup>
        <PackageReference Include="UnityEngine.Modules" IncludeAssets="compile" Version="5.6.4"/>
        <PackageReference Include="COM3D2.GameLibs" IncludeAssets="compile" Version="2.46.1-r.0"/>
        <PackageReference Include="BepInEx.Analyzers" PrivateAssets="all" Version="1.*"/>
        <PackageReference Include="BepInEx.Core" Version="5.*"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*"/>
      </ItemGroup>
      <ItemGroup>
        <!-- net35 没有 Task，沿用 BepInEx 附带的 BCL 异步补充包 -->
        <Reference Include="System.Threading">
          <HintPath>..\packages\System.Threading.dll</HintPath>
          <Private>false</Private>
        </Reference>
      </ItemGroup>
    </When>

    <!-- COM3D2.5 (3.x, Unity 2022.3) 依赖 -->
    <When Condition="$(Configuration.Contains('COM3D25_UNITY_2022-'))">
      <ItemGroup>
        <PackageReference Include="UnityEngine.Modules" IncludeAssets="compile" Version="2022.3.35"/>
        <PackageReference Include="COM3D2.GameLibs" IncludeAssets="compile" Version="3.46.1-r.0"/>
        <PackageReference Include="BepInEx.Analyzers" PrivateAssets="all" Version="1.*"/>
        <PackageReference Include="BepInEx.Core" Version="5.*"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*"/>
      </ItemGroup>
    </When>
  </Choose>

  <Choose>
    <!-- COM3D2 构建配置 -->
    <When Condition="'$(Configuration)|$(Platform)' == 'COM3D2-Debug|AnyCPU'">
      <PropertyGroup>
        <DefineConstants>COM3D2;DEBUG;TRACE</DefineConstants>
        <Optimize>false</Optimize>
        <DebugType>full</DebugType>
        <OutputPath>bin\Debug\COM3D2\</OutputPath>
        <TargetFramework>net35</TargetFramework>
      </PropertyGroup>
    </When>
    <When Condition="'$(Configuration)|$(Platform)' == 'COM3D2-Release|AnyCPU'">
      <PropertyGroup>
        <DefineConstants>COM3D2</DefineConstants>
        <Optimize>true</Optimize>
        <DebugType>pdbonly</DebugType>
        <OutputPath>bin\Release\COM3D2\</OutputPath>
        <TargetFramework>net35</TargetFramework>
      </PropertyGroup>
    </When>

    <!-- COM3D2.5 构建配置 -->
    <When Condition="'$(Configuration)|$(Platform)' == 'COM3D25_UNITY_2022-Debug|AnyCPU'">
      <PropertyGroup>
        <DefineConstants>COM3D25_UNITY_2022;DEBUG;TRACE</DefineConstants>
        <Optimize>false</Optimize>
        <DebugType>full</DebugType>
        <OutputPath>bin\Debug\COM3D25\</OutputPath>
        <TargetFramework>net48</TargetFramework>
      </PropertyGroup>
    </When>
    <When Condition="'$(Configuration)|$(Platform)' == 'COM3D25_UNITY_2022-Release|AnyCPU'">
      <PropertyGroup>
        <DefineConstants>COM3D25_UNITY_2022</DefineConstants>
        <Optimize>true</Optimize>
        <DebugType>pdbonly</DebugType>
        <OutputPath>bin\Release\COM3D25\</OutputPath>
        <TargetFramework>net48</TargetFramework>
      </PropertyGroup>
    </When>
  </Choose>

  <!-- net35 / net48 引用程序集（CI 上没有装 .NET Framework，靠这个包补） -->
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all"
      Version="1.0.3"/>
  </ItemGroup>

  <PropertyGroup>
    <Configurations>COM3D2-Debug;COM3D2-Release;COM3D25_UNITY_2022-Debug;COM3D25_UNITY_2022-Release</Configurations>
    <Platforms>AnyCPU</Platforms>

    <AssemblyName>COM3D2.PropMyItem.Plugin</AssemblyName>
    <RootNamespace>COM3D2.PropMyItem.Plugin</RootNamespace>
    <Product>COM3D2.PropMyItem.Plugin</Product>
    <Company>InoryS</Company>
    <Version>2.4.0.6</Version>
    <AssemblyVersion>2.4.0.6</AssemblyVersion>
    <FileVersion>2.4.0.6</FileVersion>

    <!-- 兜底 TFM：未匹配到上面任何配置时先给出可读报错（见 CheckGameConfiguration），
         否则会在还原阶段抛出难懂的 NETSDK1013 -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net35</TargetFramework>

    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <WarningLevel>4</WarningLevel>
    <ErrorReport>prompt</ErrorReport>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>

    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- 忘记带 -c 时给出可读的报错，而不是一堆 CS0246 -->
  <Target Name="CheckGameConfiguration" BeforeTargets="BeforeBuild">
    <Error
      Condition="'$(Configuration)' != 'COM3D2-Debug' And '$(Configuration)' != 'COM3D2-Release' And '$(Configuration)' != 'COM3D25_UNITY_2022-Debug' And '$(Configuration)' != 'COM3D25_UNITY_2022-Release'"
      Text="未知的构建配置 '$(Configuration)'。请使用 -c COM3D2-Debug / COM3D2-Release / COM3D25_UNITY_2022-Debug / COM3D25_UNITY_2022-Release 之一。"/>
  </Target>

</Project>
